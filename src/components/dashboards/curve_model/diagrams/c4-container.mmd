%% C4 Level 2: Container.
%% Every element carries name, [type: technology] and a description; every
%% relationship is labelled with intent, and those crossing the process or
%% device boundary also name the protocol. Shapes are secondary to the labels
%% and are explained in the key.
%% .
%% Deliberately NOT one container per source file: the eight term structures are
%% process state rather than a container, and the CSV/JSON outputs are one
%% dataset. An earlier version listed both and laid out 4613px wide, which is
%% not readable on a page.
flowchart TB
  MD@{ shape: lin-cyl, label: "Market data<br/><b>[External · JSON]</b><br/><small>Quotes and fixings,<br/>instrument-typed</small>" }

  subgraph HOST["Rates engine, host process"]
    direction TB
    BOOT@{ shape: subproc, label: "Curve construction<br/><b>[C++17 / QuantLib]</b><br/><small>Helpers per instrument type;<br/>all pillars solved at once</small>" }
    COEF@{ shape: subproc, label: "Coefficient extraction<br/><b>[C++17]</b><br/><small>Four logDF samples per<br/>interval give c0..c3</small>" }
    RISK@{ shape: subproc, label: "Risk engine<br/><b>[C++17 / OpenMP]</b><br/><small>PV01 by re-bootstrapping<br/>each bumped quote</small>" }
    RECON@{ shape: diam, label: "Reconciliation<br/><b>[C++17 / Python]</b><br/><small>Differences both paths;<br/>re-derives every quote</small>" }
  end

  subgraph DEV["CUDA device"]
    direction TB
    CMEM@{ shape: win-pane, label: "Coefficient store<br/><b>[CUDA global memory]</b><br/><small>c0..c3, bounds, form<br/>per curve slot</small>" }
    KERN@{ shape: hex, label: "Evaluation kernels<br/><b>[CUDA C++]</b><br/><small>Binary search then Horner;<br/>never rebuilds a curve</small>" }
  end

  PUB@{ shape: docs, label: "Published dataset<br/><b>[External · static JSON]</b><br/><small>Curves, ladders, cashflows,<br/>frozen and served with the page</small>" }

  MD -->|"read at start of run<br/><b>[file]</b>"| BOOT
  BOOT -->|"calibrated curves"| COEF
  BOOT -->|"reference prices and bumps"| RISK
  BOOT -->|"CPU reference values"| RECON
  COEF -->|"per-interval coefficients<br/><b>[cudaMemcpy H2D]</b>"| CMEM
  CMEM -->|"read by every thread"| KERN
  KERN -->|"device prices and ladders<br/><b>[kernel launch]</b>"| RISK
  KERN -->|"device values<br/><b>[kernel launch]</b>"| RECON
  RECON -->|"agreement, worst 3.6e-14"| PUB
  RISK -->|"ladders and cashflows"| PUB

  subgraph KEY[" Key "]
    direction LR
    K1@{ shape: lin-cyl, label: "file" }
    K2@{ shape: subproc, label: "code container" }
    K3@{ shape: win-pane, label: "memory" }
    K4@{ shape: hex, label: "GPU kernel" }
    K5@{ shape: diam, label: "check" }
    K6@{ shape: docs, label: "output" }
  end

  classDef bnd fill:none,stroke:#2a2a3e
  class HOST,DEV,KEY bnd
