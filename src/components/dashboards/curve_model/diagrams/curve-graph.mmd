%% Which curve needs which, and what is derived from them.
%% The FX curve is named EURUSD in the engine and labelled "under USD
%% collateral" on the chart; both names are given here.
%% One curve per currency prices the book: ESTR ECB, SOFR and SONIA. The three
%% comparison builds (ESTR tenor, ESTR IMM, ESTR IMM+futures) carry no
%% dependencies and nothing is valued on them, so they share one node.
%% The government bond curve has no parent and no child. Relative value reads
%% it beside ESTR ECB, which is a comparison and not a dependency, so that
%% link is dotted.
flowchart TB
  subgraph PRC [One pricing curve per currency]
    direction LR
    ECB["ESTR ECB<br/><small>ECB policy dated OIS · prices the EUR book</small>"]
    SOFR["SOFR<br/><small>FOMC policy dated OIS · prices the USD book</small>"]
    SONIA["SONIA<br/><small>MPC policy dated OIS · prices the GBP book</small>"]
  end

  E6["EURIBOR 6M<br/><small>projection curve · discounted on ESTR ECB</small>"]
  XC["EURUSD, the EUR FX / cross-currency curve<br/><small>EUR discounted under USD collateral</small><br/><small>built from FX swap points + xccy basis</small>"]

  ECB -- "discounts" --> E6
  ECB -- "EUR leg" --> XC
  SOFR -- "USD leg" --> XC

  E6 ~~~ XC

  FWD["FX outright forwards<br/><small>spot × DF_ccy / DF_USD</small><br/><small>the only output derived in the browser</small>"]
  XC -- "EUR leg" --> FWD
  SOFR -- "USD leg" --> FWD

  CTD["USD CSA CTD<br/><small>cheapest-to-deliver discount curve</small><br/><small>derived: max of the two parents' forwards</small>"]
  SOFR -- "parent" --> CTD
  XC -- "parent" --> CTD

  CMP["Comparison builds<br/><small>ESTR tenor · ESTR IMM · ESTR IMM+futures</small><br/><small>independent · nothing is valued on them</small>"]
  XC ~~~ CMP

  GOV["Government bond curve<br/><small>solved from 18 benchmark bonds</small><br/><small>no parent, no child · rebuilt on a bond price or a bond record</small>"]
  CMP ~~~ GOV
  RV["Bond relative value<br/><small>residual to the bond curve</small><br/><small>z-spread and asset swap spread against ESTR ECB</small>"]
  GOV -- "bonds measured against it" --> RV
  ECB -. "compared with, in one published set" .-> RV

  classDef dep stroke-width:1.5px
  classDef derived stroke-dasharray:4 3
  classDef cmp stroke-dasharray:2 3,opacity:0.7
  class E6,XC dep
  class FWD,CTD,RV derived
  class CMP cmp
