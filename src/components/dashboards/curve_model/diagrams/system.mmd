%% System / deployment view. Shape carries meaning - see the legend - and the
%% two subgraphs are a real deployment boundary: everything in Host runs in one
%% C++ process, everything in Device lives in GPU memory and is only ever
%% reached by kernel launch.
flowchart LR
  MD@{ shape: lin-cyl, label: "market_data_all_curves.json<br/><small>quotes, instrument-typed</small>" }
  FIX@{ shape: lin-cyl, label: "fixings<br/><small>historical index sets</small>" }

  subgraph HOST["Host · one C++17 process · QuantLib"]
    direction TB
    BOOT@{ shape: subproc, label: "bootstrap_module<br/><small>helpers, GlobalBootstrap</small>" }
    TS@{ shape: win-pane, label: "8 term structures<br/><small>host memory</small>" }
    COEF@{ shape: subproc, label: "spline_coeffs<br/><small>logDF to c0..c3 per interval</small>" }
    RISK@{ shape: subproc, label: "sensitivity<br/><small>OpenMP, PV01 per quote</small>" }
  end

  subgraph DEV["Device · CUDA"]
    direction TB
    CMEM@{ shape: win-pane, label: "CubicCoeffs[ ]<br/><small>per curve slot</small>" }
    KEVAL@{ shape: hex, label: "zero / forward kernels<br/><small>bsearch + Horner</small>" }
    KPRICE@{ shape: hex, label: "swap pricer<br/>pillar ladder" }
  end

  GATE@{ shape: diam, label: "reconcile<br/>CPU vs GPU" }
  OUT@{ shape: docs, label: "output/*.csv<br/>trade_details.json" }
  PUB@{ shape: lin-cyl, label: "public/data/*.json<br/><small>frozen artefact</small>" }
  SITE@{ shape: curv-trap, label: "portfolio site<br/><small>React · Cloudflare Workers</small>" }

  MD --> BOOT
  FIX --> BOOT
  BOOT --> TS
  TS --> COEF
  COEF -->|"cudaMemcpy"| CMEM
  CMEM --> KEVAL
  CMEM --> KPRICE
  TS --> RISK
  KPRICE -->|"pillar bumps"| RISK
  TS -->|"reference"| GATE
  KEVAL -->|"device"| GATE
  GATE -->|"worst 3.6e-14"| OUT
  RISK --> OUT
  OUT -->|"python export"| PUB
  PUB --> SITE

  subgraph KEY[" Legend "]
    direction LR
    L1@{ shape: lin-cyl, label: "persisted file" }
    L2@{ shape: subproc, label: "module" }
    L3@{ shape: win-pane, label: "in-memory store" }
    L4@{ shape: hex, label: "GPU kernel" }
    L5@{ shape: diam, label: "gate / check" }
    L6@{ shape: curv-trap, label: "external system" }
  end

  classDef bnd fill:none,stroke:#2a2a3e,stroke-width:1px
  class HOST,DEV,KEY bnd
