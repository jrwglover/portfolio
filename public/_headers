# index.html must never be cached. It names the hashed bundle, so a cached copy
# pins a browser to an old build: after a deploy the page looked unchanged, with
# charts and lanes from the previous version. The bundles themselves are content
# hashed and safe to cache hard.
/
  Cache-Control: no-store, must-revalidate
/index.html
  Cache-Control: no-store, must-revalidate

# Regenerated whenever the engine reruns, so never cache these either.
/data/*
  Cache-Control: no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
